          "name": "GET List all providers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is a JSON array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
