        {
          "name": "POST Create patient — Helen",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"p10\",\n  \"givenName\": \"Helen\",\n  \"familyName\": \"Bekele\"\n}"
            },
            "url": "{{baseUrl}}/api/patients"
