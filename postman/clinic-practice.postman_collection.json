{
  "info": {
    "name": "Clinic Practice API",
    "description": "Local Spring Boot API — patients + visits.\n\nPrerequisites:\n1. docker compose up -d\n2. ./mvnw spring-boot:run\n\nBase URL: http://localhost:8080",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Hello",
      "item": [
        {
          "name": "GET Hello",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/hello"
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "GET List all patients",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/patients"
          }
        },
        {
          "name": "GET Patient by id (seed patient 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/patients/1"
          }
        },
        {
          "name": "GET Patient not found",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/patients/xyz-missing"
          }
